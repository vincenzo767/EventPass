# EventPass configuration. Copy to `.env` (never commit `.env`) and fill in real values.
# The backend reads `.env` from its working directory or the repository root.

# --- Database (PostgreSQL) ----------------------------------------------------------------
# Either a full JDBC URL...
DB_URL=jdbc:postgresql://localhost:5432/eventpass
# ...or DB_HOST / DB_PORT / DB_NAME instead of DB_URL.
DB_USERNAME=eventpass
DB_PASSWORD=change-me

# --- Web --------------------------------------------------------------------------------------
# Public URL of the app, used in email ticket links.
APP_PUBLIC_BASE_URL=http://localhost:8080
# Set to true when served over HTTPS (production).
COOKIE_SECURE=false

# --- Demo data -------------------------------------------------------------------------------
# Seeds demo staff accounts and events into an EMPTY database (existing data is never touched).
DEMO_SEED=true
# Keeps seeded demo events on current dates so "event day" check-in can always be demonstrated.
DEMO_ROLLING_DATES=true
DEMO_ORGANIZER_PASSWORD=EventPass#2026
DEMO_DOOR_STAFF_PASSWORD=DoorStaff#2026

# --- Email (SMTP sandbox such as Mailtrap or Ethereal) -------------------------------------
MAIL_ENABLED=false
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your-sandbox-username
MAIL_PASSWORD=your-sandbox-password
MAIL_FROM=EventPass <no-reply@eventpass.example>

# --- Rate limits (requests per client per minute) ----------------------------------------
RATE_LIMIT_LOOKUP=10
RATE_LIMIT_REGISTRATION=10
RATE_LIMIT_CHECK_IN=120
RATE_LIMIT_LOGIN=10
